{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "master.schema.json",
  "title": "Master Resume",
  "description": "Single source of truth for every fact a Tailored Resume may use. All text is English; provenance keeps the original-language quote.",
  "type": "object",
  "required": ["basics", "experience"],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["file", "quote"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "description": "Path relative to data/raw/" },
        "quote": { "type": "string", "description": "Verbatim excerpt in the original language" }
      }
    },
    "period": {
      "type": "object",
      "required": ["start"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" },
        "end": { "type": "string", "pattern": "^(\\d{4}(-\\d{2})?|present)$" }
      }
    },
    "achievement": {
      "type": "object",
      "required": ["id", "text", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "text": { "type": "string" },
        "metrics": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" }, "minItems": 1 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "conflict": { "type": "string", "description": "Why sources disagree; resolved in the gap interview" },
        "locked": { "type": "boolean", "description": "Edited by the user; incremental scans must not overwrite" }
      }
    }
  },
  "properties": {
    "basics": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "headline": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "links": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" },
        "locked": { "type": "boolean" }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "company", "title", "period", "achievements"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "company": { "type": "string" },
          "title": { "type": "string" },
          "location": { "type": "string" },
          "period": { "$ref": "#/$defs/period" },
          "achievements": { "type": "array", "items": { "$ref": "#/$defs/achievement" } },
          "locked": { "type": "boolean" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "achievements"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "period": { "$ref": "#/$defs/period" },
          "experience_id": { "type": "string", "description": "Owning experience entry, if any" },
          "achievements": { "type": "array", "items": { "$ref": "#/$defs/achievement" } },
          "locked": { "type": "boolean" }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "category": { "type": "string" },
          "level": { "enum": ["familiar", "proficient", "expert"] },
          "evidence": { "type": "array", "items": { "type": "string" }, "description": "Achievement ids that demonstrate this skill" }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["school", "degree"],
        "additionalProperties": false,
        "properties": {
          "school": { "type": "string" },
          "degree": { "type": "string" },
          "field": { "type": "string" },
          "period": { "$ref": "#/$defs/period" }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "issuer": { "type": "string" },
          "date": { "type": "string" }
        }
      }
    }
  }
}
